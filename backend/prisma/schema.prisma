generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE")
}

model Post {
  id         String   @id @default(uuid())
  content    String   @db.VarChar(280)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model User{
  id        String @id @default(uuid())
  name      String
  username  String @unique
  email     String @unique
  password  String
  post      Post[]
}